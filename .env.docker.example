POSTGRES_DB=sureboy_realty
POSTGRES_USER=app_user
POSTGRES_PASSWORD=12345

JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Use http://localhost for local Docker testing.
# Use https://your-domain.com in production.
PUBLIC_ORIGIN=http://localhost

# Keep false for local HTTP. Set true only when serving through HTTPS.
REFRESH_COOKIE_SECURE=false

# Optional HTTPS overlay values for docker-compose.https.yml.
APP_DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# Local HTTP default. For docker-compose.https.yml, change to 127.0.0.1:8080 so Caddy owns public 80/443.
HTTP_PORT=80
VITE_API_TIMEOUT=30000
RUST_LOG=info

# Change these to long, random, private paths before production deploy.
# ADMIN_BASE_PATH is the browser path. ADMIN_API_PATH is the backend admin API path under /api.
ADMIN_BASE_PATH=/control-change-this-private-path
ADMIN_API_PATH=/core-change-this-private-path

# Web Push lead alerts. Generate with:
# npx web-push generate-vapid-keys
# The public key is baked into the frontend image; rebuild frontend after changing it.
VAPID_PRIVATE_KEY=replace_with_generated_vapid_private_key
VAPID_PUBLIC_KEY=replace_with_generated_vapid_public_key
VAPID_SUBJECT=mailto:admin@your-domain.com

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Video compression tuning (all optional; defaults shown). Change these to
# trade quality for speed without rebuilding the image.
# Re-encode downscale width (only applied when a video must be re-encoded).
# VIDEO_MAX_WIDTH=1280
# libx264 preset: ultrafast, superfast, veryfast, faster, fast, medium...
# Faster = quicker compression, slightly larger files. veryfast is a good balance.
# VIDEO_PRESET=veryfast
# VIDEO_TARGET_BITRATE=2200k
# VIDEO_MAX_BITRATE=3000k
# VIDEO_BUFFER_SIZE=6000k
# VIDEO_AUDIO_BITRATE=96k
# Already-h264 videos at/below these limits are stream-copied (seconds) instead
# of re-encoded (minutes). Raise to make more uploads near-instant; lower to
# force more compression. Bitrate is in bits per second.
# VIDEO_REMUX_MAX_WIDTH=1920
# VIDEO_REMUX_MAX_BITRATE=12000000
# Simultaneous CPU encodes. Keep at 1 on a few-core VPS so each gets all cores.
# VIDEO_MAX_CONCURRENT_ENCODES=1

# Signed video links. Public property videos are served via short-lived signed
# URLs so the links cannot be shared or hotlinked. Defaults to JWT_SECRET if
# unset; set a separate long random value to rotate independently.
# MEDIA_URL_SECRET=another_long_random_secret
# How long a signed video link stays valid (seconds). Must be long enough to
# watch a video; 3600 = 1 hour.
# MEDIA_URL_TTL_SECONDS=3600

# Container registry (GitHub Actions builds images and the VPS pulls them).
# GHCR_OWNER = your GitHub username/org in lowercase. IMAGE_TAG is usually latest.
GHCR_OWNER=your-github-username-lowercase
IMAGE_TAG=latest

POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
