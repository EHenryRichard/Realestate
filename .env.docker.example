POSTGRES_DB=sureboy_realty
POSTGRES_USER=app_user
POSTGRES_PASSWORD=12345

JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Use http://localhost for local Docker testing.
# Use https://your-domain.com in production.
PUBLIC_ORIGIN=http://localhost

# Keep false for local HTTP. Set true only when serving through HTTPS.
REFRESH_COOKIE_SECURE=false

# Optional HTTPS overlay values for docker-compose.https.yml.
APP_DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# Local HTTP default. For docker-compose.https.yml, change to 127.0.0.1:8080 so Caddy owns public 80/443.
HTTP_PORT=80
VITE_API_TIMEOUT=30000
RUST_LOG=info

# Change these to long, random, private paths before production deploy.
# ADMIN_BASE_PATH is the browser path. ADMIN_API_PATH is the backend admin API path under /api.
ADMIN_BASE_PATH=/control-change-this-private-path
ADMIN_API_PATH=/core-change-this-private-path

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
