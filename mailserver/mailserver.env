# docker-mailserver configuration. NO passwords live here — mailboxes are created
# with the `setup email add` CLI, which stores only salted hashes in
# docker-data/dms/config/postfix-accounts.cf.
# Full reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# ─── General ──────────────────────────────────────────────────────────────────
# Bounces / postmaster mail land here.
POSTMASTER_ADDRESS=postmaster@sureboyrealty.com
# One consolidated data dir under /var/mail-state.
ONE_DIR=1
# Log verbosity: info is a good production default (debug when troubleshooting).
LOG_LEVEL=info

# ─── SSL / TLS ────────────────────────────────────────────────────────────────
# Use the Let's Encrypt cert mounted from /etc/letsencrypt. DMS auto-picks
# /etc/letsencrypt/live/mail.sureboyrealty.com/ based on the container hostname.
SSL_TYPE=letsencrypt
# intermediate = broad client compatibility; use "modern" to force TLS1.2+ only.
TLS_LEVEL=intermediate

# ─── Authentication / submission ──────────────────────────────────────────────
# SMTP AUTH is enabled on 587 (STARTTLS) and 465 (implicit TLS) by default.
# Only allow authenticated senders to use their own From address (anti-spoof).
SPOOF_PROTECTION=1
# Reject obvious junk early (greylisting-style protection at connect time).
POSTSCREEN_ACTION=enforce
# Don't blanket-trust the Docker network; the app authenticates like any client.
PERMIT_DOCKER=none

# ─── DKIM / DMARC / SPF (classic OpenDKIM + OpenDMARC + policyd-spf) ───────────
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# ─── Security ─────────────────────────────────────────────────────────────────
# Fail2Ban bans IPs after repeated auth failures (needs cap_add NET_ADMIN).
ENABLE_FAIL2BAN=1

# ─── Resource-heavy scanners: OFF to keep RAM low on a shared VPS ─────────────
# Turn these on later if you want content spam/virus filtering (each adds ~1 GB).
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_RSPAMD=0

# ─── Housekeeping ─────────────────────────────────────────────────────────────
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d
